#!/usr/bin/env zsh

set -m

##################################################
# Powerlevel10k
##################################################

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

##################################################
# Zsh Plugins:
# * base16-shell for color theme
# * powerlevel10k for prompt
##################################################

# Load antidote plugin manager
source $(brew --prefix)/opt/antidote/share/antidote/antidote.zsh
antidote load   # reads ~/.zsh_plugins.txt, generates & sources a static cache

# After plugins load
base16_tomorrow-night

##################################################
# Path
##################################################

# Use GNU versions of binaries (e.g: `ls`)
export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:${PATH}"
export MANPATH="/opt/homebrew/opt/coreutils/libexec/gnuman:${MANPATH}"

# Add to the PATH
path+=("$HOME/bin")
path+=("$HOME/bin-work")
path+=("$HOME/.local/bin") # Added by pipx
export PATH

##################################################
# Zsh config files
##################################################

source ~/.zsh_aliases
source ~/.zshrc_work

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

##################################################
# SDKMan Java JDK Setup (lazy-loaded)
##################################################

export SDKMAN_DIR="$(brew --prefix)/opt/sdkman-cli/libexec"
sdk() {
  unset -f sdk 2>/dev/null
  [[ -s "${SDKMAN_DIR}/bin/sdkman-init.sh" ]] && source "${SDKMAN_DIR}/bin/sdkman-init.sh"
  sdk "$@"
}

##################################################
# NVM Setup (lazy-loaded)
##################################################

export NVM_DIR="$HOME/.nvm"
# Define shims that load nvm on first use, then hand off to the real command.
_load_nvm() {
  unset -f nvm node npm npx 2>/dev/null
  [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
  [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
}
nvm()  { _load_nvm; nvm "$@"; }
node() { _load_nvm; node "$@"; }
npm()  { _load_nvm; npm "$@"; }
npx()  { _load_nvm; npx "$@"; }

##################################################
# Other
##################################################

export HISTSIZE=1000000
export SAVEHIST=1000000

# Set up fzf key bindings and fuzzy completion
source <(fzf --zsh)
