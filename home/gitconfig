[user]
  name = Elie Moreau
  email = emoreau@atlassian.com

# Override https urls with ssh ones
[url "ssh://git@stash.atlassian.com:7997/"]
  insteadOf = https://stash.atlassian.com/scm/
[url "git@bitbucket.org:"]
  insteadOf = https://bitbucket.org/
[url "git@github.com:"]
  insteadOf = https://github.com/

# Config for common git operations
[init]
  defaultBranch = main
[push]
  default = current
  autoSetupRemote = true
[pull]
  rebase = true

# Config for visual elements of git
[core]
  editor = vim
[color]
  interactive = auto
  branch = auto
  diff = auto
  status = auto

# Config for git lfs support
[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process

# Config for git-delta, which provides syntax highlighting and readable,
# navigable unified diffs. It also preserves Git's patch format for `git add -p`.
[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only --features=interactive
[delta]
  syntax-theme = base16
  features = decorations
  navigate = true
  line-numbers = true
  line-numbers-minus-style = "#cc6666"
  line-numbers-plus-style = "#b5bd68"
  line-numbers-left-style = "#969896"
  line-numbers-right-style = "#969896"
  line-numbers-zero-style = "#969896"
  side-by-side = false
  keep-plus-minus-markers = true
  # Muted backgrounds blended from Tomorrow Night's base and red/green.
  minus-style = syntax "#3d2c2d"
  minus-emph-style = syntax "#522a2a"
  plus-style = syntax "#383b2e"
  plus-emph-style = syntax "#4a4e36"
[delta "interactive"]
  keep-plus-minus-markers = false
[delta "decorations"]
  commit-decoration-style = "#81a2be" ol
  commit-style = raw
  file-style = omit
  hunk-header-decoration-style = "#81a2be" box
  hunk-header-file-style = "#81a2be"
  hunk-header-line-number-style = "#969896"
  hunk-header-style = file line-number syntax

# Highlight code moved within a diff, including indentation-only changes.
[diff]
  colorMoved = zebra
  colorMovedWS = allow-indentation-change
  renames = copies
  mnemonicPrefix = true
