function dkls() {
    local _filename=""
    if [[ -f "./docker-compose.yml" ]]; then
        _filename="./docker-compose.yml"
    elif [[ -f "./docker-compose.yaml" ]]; then
        _filename="./docker-compose.yaml"
    else
        echo "No docker-compose.yml OR docker-compose.yaml file"
        return 1
    fi

    cat "${_filename}" | yq -r '(["SERVICE NAME", "DOCKER IMAGE:TAG"] | (., map(length * "-"))), (.services | to_entries[] | [.key, if (.value.image == null) then (.value.build | if (type == "string") then . else .context end) else .value.image end]) | @tsv' | column -ts$'\t'
}

