function jqhead_old() {
    local _number=$1

    if [[ -z "${_number}" ]]; then
        _number=1
    fi

    local _repeated=$(python -c "print('[]?' * ${_number})")

    jq 'reduce path(.'"${_repeated}"') as $path (.; setpath($path; {}))'
}

function jqhead() {
    local _path=${1}
    local _number=${2}

    if [[ -z "${_path}" ]]; then
        _path='.'
    else
        shift
    fi

    if [[ -z "${_number}" ]]; then
        _number=1
    else
        shift
    fi

    local _repeated=$(printf '[]?%.0s' $(seq 1 ${_number}))

    jq "${_path}"' | reduce path(.'"${_repeated}"') as $path (.; setpath($path; {}))' $@
}

# Create a play directory under the temporary file system and change to that
# directory.
function p() {
    cd $(mktemp -d)
}

function _ph_date() {
    date "+%Y-%m-%d--%H%M%S"
}

# Create a play directory under $HOME and change to that directory. Allows for
# comments.
function ph() {
    if [[ $# -ne 1 && $# -ne 0 ]]; then
        echo "Usage: ph [NAME]"
        return 1
    fi

    # If no argument, let's ask for a name.
    if [[ $# -eq 0 ]]; then
        echo -n "name: "
        read _name

        local _name=$(echo "${_name}" | sed -e 's/ *$//' | tr -d '\n')

        for _stupid_name in asd; do
            if [[ "${_name}" == "${_stupid_name}" ]]; then
                echo "You can just leave the name blank instead of using a stupid name."
                _name=""
            fi
        done

        # If the name is not empty, then add a delimiter
        if [[ ! -z "${_name}" ]]; then
            _name="--${_name}"
        fi

        mkdir -p "${HOME}/tmp"
        TEMPDIR=$(mktemp -d "${HOME}/tmp/$(_ph_date)${_name}")
        cd "${TEMPDIR}"
        return 0
    fi

    # If name given, then let's goooooooooooo
    if [[ $# -eq 1 ]]; then
        name=${1}
        mkdir -p "${HOME}/tmp"
        TEMPDIR=$(mktemp -d "${HOME}/tmp/$(_ph_date)--${name}")
        cd "${TEMPDIR}"
        return 0
    fi
}

function notif() {
    TITLE=${1}
    MESSAGE=${2}

    if [[ -z ${TITLE} ]] || [[ -z ${MESSAGE} ]] || [[ "${#}" -ne 2 ]]; then
        osascript -e 'display notification "usage: notif TITLE MESSAGE" with title "Notification Failure"'
    fi

    osascript -e "display notification \"${MESSAGE}\" with title \"${TILE}\""
}

function long() {
    if which gtime 2>/dev/null 1>/dev/null; then
        gtime_out=$(mktemp)
        gtime --output "${gtime_out}" --format "%E|%S|%U|%x" $@

        wall_time=$(cat "${gtime_out}" | awk -F "|" '{print $1}')
        syst_time=$(cat "${gtime_out}" | awk -F "|" '{print $2}')
        user_time=$(cat "${gtime_out}" | awk -F "|" '{print $3}')
        exit_code=$(cat "${gtime_out}" | awk -F "|" '{print $4}')
        notif "Command Completed" "Took ${wall_time}\nExited with ${exit_code}"
    else
        time $@
        notif "Command Completed" "$@"
    fi
}

