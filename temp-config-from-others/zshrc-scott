function ad() {
    SEARCH_BASE="${1}"
    FILTER="${2}"

    if [[ -z "${SEARCH_BASE}" ]] || [[ -z "${FILTER}" ]] || [[ "$#" -ne 2 ]]; then
        echo "usage: ad SEARCH_BASE FILTER"
        return
    fi

    local _LDAP_HOST="ldap://usw2a-ad01.office.atlassian.com"

    # -Q -- Enable SASL Quiet mode. Never prompt.
    # -LLL -- Better formatting
    # -E pr=1000/noprompt -- Page results
    # -o ldif-wrap=no -- ??
    # -b <searchbase> -- Starting point for search
    # -X <authzid> -- Who do we want to auth as?
    # -O maxssf=0 -- Turn off the SASL security property maxssf. DISABLED
    # -ZZ
       #-H 'ldap://office.atlassian.com'\
    ldapsearch\
       -Q\
       -H "${_LDAP_HOST}"\
       -Y GSSAPI\
       -LLL\
       -E pr="1000/noprompt"\
       -b "${SEARCH_BASE}"\
       -X "dn:CN=${USER},OU=people,DC=office,DC=atlassian,DC=com"\
       -o "ldif-wrap=no"\
       ${FILTER}
}

# Examples:
#   adp "(name=sgreenup")
#   adp "(personalTitle=P7*)"
#   adp "(displayName=Scott *)"
#   adp "(CN=sgreenup)"
function adp() {
    ad "OU=people,DC=office,DC=atlassian,DC=com" ${@}
}

# Examples:
#   adg "(CN=micros*)"
function adg() {
